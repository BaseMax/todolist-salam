package service

import sort
import time
include model "model.salam"
include store "store.salam"
include validate "validate.salam"
include apierr "apierr.salam"

@doc "the write went through"
pub const OutcomeOk := "ok"
@doc "no task has that id"
pub const OutcomeNotFound := "not_found"
@doc "a field did not validate"
pub const OutcomeInvalid := "invalid"

@doc "the filters, ordering and paging a list request asked for"
pub struct Query:
    pub status: str = ""
    pub priority: str = ""
    pub tag: str = ""
    pub search: str = ""
    pub sort: str = "id"
    pub order: str = "desc"
    pub limit: int = 20
    pub offset: int = 0
end

@doc "counts across the whole list"
pub struct Stats:
    pub total: int = 0
    pub pending: int = 0
    pub in_progress: int = 0
    pub completed: int = 0
    pub overdue: int = 0
end

func has_tag(t: model.Task, tag: str): bool:
    each item in t.tags:
        if item == tag:
            ret true
        end
    end
    ret false
end

func text_matches(t: model.Task, needle: str): bool:
    lowered := needle.lower()
    ret t.title.lower().includes(lowered) or t.description.lower().includes(lowered)
end

func matches(t: model.Task, q: Query): bool:
    if q.status.len() > 0 and t.status != q.status:
        ret false
    end
    if q.priority.len() > 0 and t.priority != q.priority:
        ret false
    end
    if q.tag.len() > 0 and not has_tag(t, q.tag):
        ret false
    end
    if q.search.len() > 0 and not text_matches(t, q.search):
        ret false
    end
    ret true
end

func sort_matched(v: Vector<model.Task>, key: str, descending: bool):
    if key == "title":
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret a.title < b.title end)
    else key == "priority":
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret model.PriorityRank(a.priority) < model.PriorityRank(b.priority) end)
    else key == "created_at":
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret a.created_at < b.created_at end)
    else key == "updated_at":
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret a.updated_at < b.updated_at end)
    else key == "due_date":
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret a.due_date < b.due_date end)
    else:
        sort.StableSortBy(v, (a: model.Task, b: model.Task): ret a.id < b.id end)
    end
    if descending:
        sort.Reverse(v)
    end
end

@doc "The page a list request asked for, and how many tasks matched it."
pub func List(q: Query, total &: int): Vector<model.Task>:
    snapshot := store.Snapshot()
    defer snapshot.free()
    mut matched := Vector {} as Vector<model.Task>
    each t in snapshot:
        if matches(t, q):
            matched.push(t)
        end
    end
    total = matched.len()
    sort_matched(matched, q.sort, q.order == "desc")
    mut page := Vector {} as Vector<model.Task>
    mut i := q.offset
    until i < matched.len() and page.len() < q.limit:
        page.push(matched.get(i))
        i = i + 1
    end
    matched.free()
    ret page
end

@doc "Count the tasks by status, and the ones already past their due date."
pub func Summary(): Stats:
    snapshot := store.Snapshot()
    defer snapshot.free()
    today := time.FormatDate(time.Now())
    mut s := Stats {}
    each t in snapshot:
        s.total = s.total + 1
        if t.status == model.StatusPending:
            s.pending = s.pending + 1
        else t.status == model.StatusInProgress:
            s.in_progress = s.in_progress + 1
        else:
            s.completed = s.completed + 1
        end
        if not model.IsCompleted(t.status) and t.due_date.len() > 0 and t.due_date < today:
            s.overdue = s.overdue + 1
        end
    end
    ret s
end

@doc "Look one task up."
pub func Get(id: i64, out &: model.Task): bool:
    ret store.Find(id, out)
end

@doc "Create a task out of a request body."
pub func Create(body: str, out &: model.Task, issues &: Vector<apierr.FieldIssue>): bool:
    mut draft := model.Task {}
    blank := model.Task {}
    if not validate.Apply(body, blank, true, draft, issues):
        draft.tags.free()
        ret false
    end
    out = store.Create(draft)
    ret true
end

@doc "Replace or patch a task out of a request body."
pub func Update(id: i64, body: str, partial: bool, out &: model.Task, issues &: Vector<apierr.FieldIssue>): str:
    mut base := model.Task {}
    if not store.Find(id, base):
        ret OutcomeNotFound
    end
    mut draft := model.Task {}
    if not validate.Apply(body, base, not partial, draft, issues):
        draft.tags.free()
        ret OutcomeInvalid
    end
    if not store.Replace(id, draft):
        draft.tags.free()
        ret OutcomeNotFound
    end
    if not store.Find(id, out):
        ret OutcomeNotFound
    end
    ret OutcomeOk
end

@doc "Mark a task complete, or open it again."
pub func SetStatus(id: i64, status: str): bool:
    now := time.FormatISO(time.Now())
    mut completed_at := ""
    if model.IsCompleted(status):
        completed_at = now
    end
    ret store.SetStatus(id, status, completed_at, now)
end

@doc "Delete one task."
pub func Remove(id: i64): bool:
    ret store.Remove(id)
end

@doc "Delete every completed task."
pub func RemoveCompleted(): int:
    ret store.RemoveCompleted()
end
