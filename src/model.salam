package model

pub const StatusPending := "pending"
pub const StatusInProgress := "in_progress"
pub const StatusCompleted := "completed"

pub const PriorityLow := "low"
pub const PriorityMedium := "medium"
pub const PriorityHigh := "high"
pub const PriorityUrgent := "urgent"

@doc "one task, exactly as the API hands it back"
pub struct Task:
    @doc "assigned by the server and never reused"
    pub id: i64 = 0 as i64
    @doc "the one line that says what to do"
    pub title: str = ""
    @doc "the longer version, when one line is not enough"
    @json "" "omitempty"
    pub description: str = ""
    @doc "pending, in_progress or completed"
    pub status: str = StatusPending
    @doc "low, medium, high or urgent"
    pub priority: str = PriorityMedium
    @doc "free-form labels"
    pub tags: Vector<str> = Vector {}
    @doc "the day it is due, as YYYY-MM-DD"
    @json "" "omitempty"
    pub due_date: str = ""
    @doc "when the task was created"
    pub created_at: str = ""
    @doc "when any field last changed"
    pub updated_at: str = ""
    @doc "when the task was completed, empty while it is open"
    @json "" "omitempty"
    pub completed_at: str = ""
end

@doc "the body a client sends to create, replace or patch a task"
pub struct TaskInput:
    @doc "required, up to 200 characters"
    pub title: str = ""
    @doc "up to 2000 characters"
    @json "" "omitempty"
    pub description: str = ""
    @doc "pending, in_progress or completed; defaults to pending"
    pub status: str = StatusPending
    @doc "low, medium, high or urgent; defaults to medium"
    pub priority: str = PriorityMedium
    @doc "up to 20 labels, each up to 40 characters"
    pub tags: Vector<str> = Vector {}
    @doc "the due date, as YYYY-MM-DD"
    @json "" "omitempty"
    pub due_date: str = ""
end

@doc "Whether a word names a status the API accepts."
pub func ValidStatus(text: str): bool:
    ret text == StatusPending or text == StatusInProgress or text == StatusCompleted
end

@doc "Whether a word names a priority the API accepts."
pub func ValidPriority(text: str): bool:
    ret text == PriorityLow or text == PriorityMedium or text == PriorityHigh or text == PriorityUrgent
end

@doc "the sort order of a priority, low first"
pub func PriorityRank(p: str): int:
    if p == PriorityLow:
        ret 0
    else p == PriorityHigh:
        ret 2
    else p == PriorityUrgent:
        ret 3
    end
    ret 1
end

@doc "Whether a status means the task is finished."
pub func IsCompleted(status: str): bool:
    ret status == StatusCompleted
end
